rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ 系統管理員 Email（你自己），可以管理所有比賽、匯入匯出資料
    function isSuper() {
      return request.auth != null
        && request.auth.token.email in ['你的管理員email@example.com'];
    }
    function signedIn() { return request.auth != null; }
    function comp(cid) { return get(/databases/$(database)/documents/comps/$(cid)).data; }
    // 這場比賽的主辦：建立者、輸入過管理碼的人、或系統管理員
    function isCompAdmin(cid) {
      return signedIn() && (
        isSuper()
        || comp(cid).ownerId == request.auth.uid
        || exists(/databases/$(database)/documents/compAdmins/$(cid + '_' + request.auth.uid))
      );
    }

    match /comps/{cid} {
      allow read: if true;
      // 任何人都可以建立比賽，建立者就是主辦
      allow create: if isSuper() || (signedIn() && request.resource.data.ownerId == request.auth.uid);
      // 只有主辦能改設定、計時；不能把比賽轉給別人
      allow update: if isCompAdmin(cid)
        && request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null);
      allow delete: if isCompAdmin(cid);

      // 路線照片、裁判記的成績：主辦才能改
      match /{sub=**} {
        allow read: if true;
        allow write: if isCompAdmin(cid);
      }

      // 選手自己的報名與成績：每個人只能改自己的
      // 主辦關閉「自行記分」時，選手可以報名、取消報名，但不能改成績
      match /entries/{uid} {
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && (
          comp(cid).get('selfScoring', true) != false
          || request.resource.data.get('results', {}) == resource.data.get('results', {})
        );
      }
    }

    // 管理碼：只有主辦看得到
    match /compKeys/{cid} {
      allow read: if isCompAdmin(cid);
      allow create: if isSuper() || (signedIn() && comp(cid).ownerId == request.auth.uid);
      allow update, delete: if isCompAdmin(cid);
    }

    // 輸入正確管理碼的人成為協同主辦
    match /compAdmins/{id} {
      allow get: if signedIn() && id.matches('^[A-Za-z0-9]+_' + request.auth.uid + '$');
      allow create: if signedIn()
        && id == request.resource.data.compId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key == get(/databases/$(database)/documents/compKeys/$(request.resource.data.compId)).data.key;
      allow delete: if isSuper();
    }
  }
}
